# Optional contextual category imagery. Placeholder values only; no key is included.
GOOGLE_API_KEY=replace-with-google-api-key
GOOGLE_CSE_ID=replace-with-programmable-search-engine-id
UNSPLASH_ACCESS_KEY=replace-with-unsplash-access-key

# Ordered fallback providers. Unconfigured providers are skipped.
CIVICPULSE_IMAGE_PROVIDERS=google,unsplash,local

# One remote provider search per category per day, with a shared daily cap.
CIVICPULSE_IMAGE_DAILY_BUDGET=20
CIVICPULSE_IMAGE_TIMEOUT_SECONDS=4
CIVICPULSE_IMAGE_CACHE_PATH=government_service_request_app/category_image_cache.json
