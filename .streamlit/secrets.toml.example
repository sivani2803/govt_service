# Copy this file to secrets.toml and replace every sample value.
# Register this callback URL with your OIDC provider and the hosted app URL.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-oidc-client-id"
client_secret = "replace-with-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[roles]
administrators = ["admin@example.org"]
officers = ["officer@example.org"]

# Optional contextual category images. Google is selected first when both
# credentials are configured; otherwise CivicPulse tries Unsplash, then local art.
[media]
google_api_key = "replace-with-google-api-key"
google_cse_id = "replace-with-programmable-search-engine-id"
unsplash_access_key = "replace-with-unsplash-access-key"

# Optional. Without this key, the map uses OpenStreetMap tiles with a dark
# tile-pane treatment so local development still shows a complete map.
[maps]
carto_basemap_key = "replace-with-carto-basemap-key"
